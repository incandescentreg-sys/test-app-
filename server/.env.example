# ── Backend (Vercel Functions) ────────────────────────────────────────────
# Всё ниже — СЕКРЕТЫ сервера. Ни одна из этих переменных не должна
# попадать во фронтенд (во frontend только VITE_*). Подробности в docs/BACKEND.md.

# Токен бота от BotFather. Обязателен: без него нельзя проверять подпись initData.
BOT_TOKEN=
BOT_USERNAME=YablokoVPNBot

# Насколько долго живёт initData, секунды. По умолчанию сутки.
INIT_DATA_MAX_AGE_SEC=86400

# ── База данных (Neon / Supabase / свой Postgres) ─────────────────────────
DATABASE_URL=

# ── Панель H1VLESS ────────────────────────────────────────────────────────
# Либо готовый токен, либо логин/пароль — тогда backend логинится сам.
H1VLESS_BASE_URL=http://nl6.h1cloud.net:25108
H1VLESS_TOKEN=
H1VLESS_USERNAME=
H1VLESS_PASSWORD=

# Префикс имени клиента в панели (итого: tg<telegramId>).
H1VLESS_CLIENT_PREFIX=tg

# ── Параметры приложения ─────────────────────────────────────────────────
APP_NAME=Яблоко VPN
SUPPORT_USERNAME=Yablokovpn_sup
CURRENCY=RUB
MIN_WITHDRAWAL_AMOUNT=50000
REFERRAL_BONUS_PERCENT=20
EXPIRING_SOON_DAYS=5
DEVICE_LIMIT=0
TRAFFIC_LIMIT_GB=0

# ── Платежи ──────────────────────────────────────────────────────────────
# Пока false: тарифы видны, но POST /payments/create отвечает 503.
PAYMENTS_ENABLED=false
ORDER_TTL_MINUTES=30

# Секрет служебного маршрута /api/admin/provision (ручная выдача подписки).
ADMIN_SECRET=

# Секрет webhook'а /api/webhooks/payment.
WEBHOOK_SECRET=

# Домены для CORS. Пусто = CORS не нужен (Mini App и backend на одном домене).
ALLOWED_ORIGINS=