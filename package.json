{
  "name": "vpn-telegram-miniapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram Mini App «Яблоко VPN» + backend (Vercel Functions) с интеграцией H1VLESS",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx --env-file=server/.env scripts/dev-api.ts",
    "build": "npm run build:functions && prisma generate && tsc --noEmit && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=server/.env scripts/seed.ts",
    "test:h1vless": "tsx --env-file=server/.env scripts/smoke-h1vless.ts",
    "test:initdata": "tsx scripts/test-initdata.ts",
    "test": "npm run typecheck && npm run typecheck:api && npm run test:initdata",
    "db:local": "tsx scripts/db-local.ts",
    "test:e2e": "tsx --env-file=server/.env scripts/test-e2e.ts",
    "provision": "tsx --env-file=server/.env scripts/provision.ts",
    "check:token": "tsx --env-file=server/.env scripts/check-token.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "build:functions": "tsx scripts/build-functions.ts",
    "verify": "npm run typecheck && npm run typecheck:api && npm run test:initdata",
    "test:prod": "tsx scripts/test-prod.ts",
    "db:seed:prod": "tsx scripts/seed.ts",
    "check:auth": "tsx scripts/check-auth.ts",
    "rotate:secrets": "tsx scripts/rotate-secrets.ts",
    "test:ed25519": "tsx scripts/test-ed25519.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.5.4",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.14.47": true,
    "esbuild@0.28.2": true
  }
}
