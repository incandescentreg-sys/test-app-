# ─────────────────────────────────────────────────────────────
#  VITE_* переменные попадают в КЛИЕНТСКИЙ бандл. Это публичные данные.
#  НИКОГДА не добавляйте сюда секреты (H1VLESS_API_TOKEN, DATABASE_URL,
#  BOT_TOKEN, PRIVATE_KEY) — всё это живёт только в env самого backend на Vercel.
# ─────────────────────────────────────────────────────────────

# База API.
#  • Если backend на том же Vercel-проекте (папка /api) — оставьте /api
#  • Если backend на отдельном домене — укажите полный URL, например https://api.example.com
VITE_API_BASE_URL=/api

# Username бота без @ — используется только как fallback для реферальной ссылки,
# если backend не вернул готовую referralLink в /api/me.
VITE_BOT_USERNAME=

# ── Контент, который можно менять без правки кода ───────────────────────────
# Поддержка: плашка в шапке главной, кнопки «Написать в поддержку»
# на экране оплаты и в инструкции, строка «Поддержка» в профиле.
VITE_SUPPORT_URL=https://t.me/Yablokovpn_sup
VITE_SUPPORT_USERNAME=Yablokovpn_sup

# Ссылка на политику конфиденциальности (страница «Политика конфиденциальности»)
VITE_PRIVACY_URL=

# Версия приложения — показывается в профиле
VITE_APP_VERSION=1.0.0

# ── Только для локальной разработки в обычном браузере ───────────────────────
# Включает мок-API, чтобы увидеть UI без Telegram. Собирается ТОЛЬКО при
# import.meta.env.DEV и физически вырезается из production-бандла.
VITE_ENABLE_MOCK_API=false